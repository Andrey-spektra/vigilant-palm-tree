@echo off
REM ============================================================
REM  Исполняющий файл для запуска игры «СИЛА СЛОВА» (Windows)
REM  Использование: двойной клик или запуск из командной строки
REM ============================================================
cd /d "%~dp0"

set PORT=8000
set GAME_FILE=СИЛА_СЛОВА_игра.html

if not exist "%GAME_FILE%" (
    echo ОШИБКА: не найден файл игры: %cd%\%GAME_FILE%
    pause
    exit /b 1
)

echo ===============================================
echo   Запуск игры «СИЛА СЛОВА»
echo   Адрес: http://localhost:%PORT%/%GAME_FILE%
echo   Закройте это окно, чтобы остановить сервер.
echo ===============================================

start "" "http://localhost:%PORT%/%GAME_FILE%"
python -m http.server %PORT% --bind 127.0.0.1
pause
